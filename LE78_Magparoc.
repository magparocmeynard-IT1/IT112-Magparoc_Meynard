#include <stdio.h>
#include <string.h>

#define MAX 100

int main() {
    int numbers[MAX];
    int n, i, largest;

    printf("Enter number of elements in the array: ");
    scanf("%d", &n);

    if (n < 1 || n > MAX) {
        printf("Invalid size. Please enter 1 to %d.\n", MAX);
        return 1;
    }

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &numbers[i]);
    }

    largest = numbers[0];             
    for (i = 1; i < n; i++) {
        if (numbers[i] > largest) {
            largest = numbers[i];
        }
    }
    printf("The largest element in the array is: %d\n\n", largest);

    char str[100];
    int vowels = 0;
    int len;

    getchar();                         

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);    
    
    len = strlen(str);
    for (i = 0; i < len; i++) {
        char c = str[i];
        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
            c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U') {
            vowels++;
        }
    }
    printf("The number of vowels in the string is: %d\n", vowels);

    return 0;
}
